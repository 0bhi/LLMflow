{
  "id": null,
  "title": "LLMflow Monitoring",
  "tags": ["llmflow"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Inference Request Latency (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(inference_request_latency_ms_bucket[5m]))",
          "legendFormat": "p95 {{model}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Requests per Second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(inference_requests_total[5m])",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Tokens Generated per Second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(inference_tokens_generated_total[5m])",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Total Requests",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(inference_requests_total)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
